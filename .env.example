# Copy to .env for local development. Never commit real values.
APP_ENV=development                     # development | test | staging | production
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://USER@localhost:5432/metours_dev
TEST_DATABASE_URL=postgresql://USER@localhost:5432/metours_test        # name must end with _test
E2E_DATABASE_URL=postgresql://USER@localhost:5432/metours_e2e_test     # name must end with _test

# openssl rand -base64 48
SESSION_SECRET=
TICKET_SIGNING_SECRET=

# Phase 3+
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
BREVO_API_KEY=
MAIL_FROM=
S3_ENDPOINT=
S3_BUCKET_PRIVATE=
S3_BUCKET_PUBLIC=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Mapbox (Destination Explorer). Public token only (pk.…), scopes: styles:tiles, styles:read, fonts:read
# (+ directions via public token). Restrict it to the site's URLs in the Mapbox account.
# Never put a secret token (sk.…) here – NEXT_PUBLIC_ values are sent to every browser.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Automated tests only: APP_ENV=test + TEST_PAYMENTS=1 replaces the Stripe page by a signed test event.
# env() refuses to start production with this flag.
# TEST_PAYMENTS=1
